[Unit]
Description=ocbot backup (SQLite diary + signal-cli identity keys, 14-day retention)
After=ocbot.service
# A failed backup must be visible, not silent (NFR-12).

[Service]
Type=oneshot
User=ocbot
Group=ocbot
WorkingDirectory=/srv/ocbot
EnvironmentFile=/etc/ocbot/ocbot.env
Environment=OCBOT_DB=/srv/ocbot/ocbot.db
Environment=OCBOT_BACKUP_DIR=/srv/ocbot/backups
Environment=OCBOT_BACKUP_RETAIN_DAYS=14
Environment=OCBOT_SIGNAL_DATA_DIR=/var/lib/signal-cli
# The signal-cli identity keys live outside /srv/ocbot; backing them up means a
# re-link (and a new safety number) is never needed after a host loss.
ReadWritePaths=/var/lib/signal-cli /srv/ocbot/backups
ExecStart=/srv/ocbot/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
