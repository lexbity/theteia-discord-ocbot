# ocbot configuration (spec §6.8). Unknown keys are a load error.
# Secrets come from the environment: DISCORD_TOKEN, OPENCODE_PASSWORD,
# ALLOWED_USER_ID (optional override of allowed_user_id below).

# The opencode v2 server. Loopback only unless ALLOW_NON_LOOPBACK=true (FR-4).
opencode_url = "http://127.0.0.1:8080"

# Where the SQLite diary lives (P15).
db_path = "ocbot.db"

# Directory containing fresh.md / resume.md (P13, load-time validated).
templates_dir = "templates"

# Watcher poll interval (S-2 locked default).
poll_interval_ms = 2000

# Loopback metrics endpoint (NFR-9).
metrics_bind = "127.0.0.1:9464"

# Per-command git timeout (R-9).
git_timeout_secs = 10

# Gate lifecycle: poll interval and re-ping cadence for unanswered gates (P4).
# gate_poll_interval_ms = 2000
# perm_reping_minutes = 10

# Inbox (P14): where external completions post (falls back to [discord]
# ops_channel), and the root-session poll interval (S-7 default 5 s).
# inbox_poll_interval_ms = 5000

# `/abort` waits this long for the server to confirm idle before giving up (FR-10).
# abort_timeout_secs = 30

# FR-42 (off by default): attach config/opencode.permissions.jsonc to each
# created session. Keep off until S-3 confirms combine semantics (D-R6).
# per_session_ruleset = false
# permissions_file = "config/opencode.permissions.jsonc"

# Phase 6 files & plans -------------------------------------------------------
# The roots the /ls browser and typed paths are confined to (P11/FR-34).
# browse_roots = ["/home"]

# Where uploaded attachments are persisted (P11/FR-36).
# inbox_dir = "inbox"

# Allow typed paths outside browse_roots (default false; P11).
# allow_freeform_paths = false

# Plan picker heading depth range (P12; default 2..=3).
# plan_heading_min = 2
# plan_heading_max = 3

# /ls entries per page (P10).
# ls_page_size = 18

# Phase 7 ops -----------------------------------------------------------------
# Minutes of silence before the stall watchdog posts one ping (P3/FR-39).
# stall_minutes = 45

# Cadence of the ops loop: reachability (FR-38), derived gauges, stall scan.
# ops_poll_interval_ms = 30000

# Regexes scrubbed from the *inline* report path (R-12). The full report body
# (DB + report.md attachment) is stored verbatim for the operator's audit trail.
# redact_patterns = [
#   "(?i)discord[_-]?token\\s*[:=]\\s*[A-Za-z0-9._\\-]{8,}",
#   "(?i)opencode[_-]?password\\s*[:=]\\s*\\S+",
#   "(?i)api[_-]?key\\s*[:=]\\s*\\S+",
#   "(?i)bearer\\s+[A-Za-z0-9._\\-]{8,}",
# ]

# The chat surfaces to run (SPEC-004 D-09): one name or a list; the default
# is ["discord"]. Selecting "signal" is refused until the Signal surface
# ships — carrying a [signal] section while running Discord-only is fine.
# channel = ["discord"]

[discord]
# The ops channel. DMs with the operator are always allowed (FR-2).
ops_channel = 123456789012345678
# The operator Discord user id. Env ALLOWED_USER_ID overrides it.
allowed_user_id = 123456789012345678
# How much of a report reaches Discord: "full" | "excerpt" | "off" (D-12).
# report_excerpt = "excerpt"
# Whether report.md attachments leave the host at all (D-12: default false).
# report_attachments = false

[signal]
# The signal-cli JSON-RPC daemon's unix socket and the operator's E.164
# number (the single allowlisted sender). Env SIGNAL_OPERATOR overrides.
# socket = "/run/signal-cli/socket"
# operator_number = "+15551234567"
# E2E to the operator's phone: full reports and attachments by default (D-12).
# report_excerpt = "full"
# report_attachments = true
# Inbound command token bucket (D-11.4).
# rate_limit = { capacity = 10, refill_per_sec = 1.0 }
